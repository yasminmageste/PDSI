    "def create_sine_signal(P, A=1.0, phi=0.0, fs=48e3, dur=1.0):\n",
    "    '''\n",
    "    P  : period (samples)\n",
    "    A  : amplitude\n",
    "    phi: phase\n",
    "    dur: duration (seconds)\n",
    "    fs : sampling frequency (Hz)\n",
    "    '''\n",
    "    \n",
    "    N = int(dur * fs)\n",
    "    n= np.arange(N)\n",
    "    w0 = 2 * np.pi/ P\n",
    "    x = A * np.sin(w0 * n + phi)\n",
    "\n",
    "    return x, fs\n"
   ]
