    "def SIGNALwaveform(f=440, dur=1.0):\n",
    "    '''\n",
    "    Tone with a random waveform as input\n",
    "\n",
    "    f: Signal frequency\n",
    "    dur: Duration (seconds)\n",
    "\n",
    "    x: Output signal\n",
    "    fs: Sampling freq. (default: CD standard)\n",
    "    '''\n",
    "    fs = 44100  # CD standard\n",
    "    N = dur * fs\n",
    "    P = round(fs / f)  # Periodo por amostra\n",
    "\n",
    "    waveform = SIGNALgenerate(N=P, signal = 'random')\n",
    "    \n",
    "    repetitions = int(np.ceil(N / P)) #é uma função da biblioteca NumPy que arredonda cada número para cima, em direção ao inteiro mais próximo\n",
    "    x = np.tile(waveform, repetitions) #serve para construir um novo array repetindo um array inteiro \n",
    "    x = x[:N]\n",
    "\n",
    "    return x, fs"
   ]
  },
